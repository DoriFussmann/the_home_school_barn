---
/**
 * Product page for one resource. Built only for published resource files in
 * src/content/resources/. Shows only the facts the file provides.
 */
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import { orgId } from "seo-core";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import FreeDownloadForm from "../../components/FreeDownloadForm.astro";
import { SITE_URL } from "../../config/site";
import { getPublishedCollections, getPublishedResources, schemaCurrency, schemaPrice, type Resource } from "../../lib/resources";
import { topicByName, topicLabel } from "../../lib/topics";
import { absoluteFileUrl, absoluteUrl, sitePath } from "../../lib/url";

export async function getStaticPaths() {
  const resources = await getPublishedResources();
  return resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}

const { resource } = Astro.props as { resource: Resource };
const { data } = resource;
const { Content } = await render(resource);
const path = `/resources/${resource.id}/`;

const inCollections = (await getPublishedCollections()).filter((c) =>
  c.data.resources.some((ref) => ref.id === resource.id),
);

const facts = [
  { label: "Price", value: data.free ? "Free (email address required)" : data.price },
  { label: "Ages", value: data.ages },
  { label: "Format", value: data.format },
  { label: "Pages", value: data.pages ? String(data.pages) : undefined },
  { label: "File size", value: data.fileSize },
  { label: "Subjects", value: data.subjects.map(topicLabel).join(", ") || undefined },
  { label: "Themes", value: data.themes.join(", ") || undefined },
  { label: "Parent guide", value: data.includesParentGuide ? "Included" : undefined },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));

const coverImage = data.cover ? await getImage({ src: data.cover, width: 1200 }) : undefined;
const price = data.free ? "0.00" : schemaPrice(data.price);
const jsonLd: Record<string, unknown>[] = [
  {
    "@type": "Product",
    name: data.title,
    description: data.summary,
    url: absoluteUrl(path),
    brand: { "@id": orgId(SITE_URL) },
    category: "Printable educational resource",
    ...(coverImage ? { image: absoluteFileUrl(coverImage.src) } : {}),
    ...(price
      ? {
          offers: {
            "@type": "Offer",
            price,
            priceCurrency: schemaCurrency(data.price),
            availability: "https://schema.org/InStock",
            url: absoluteUrl(path),
          },
        }
      : {}),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: "Resources", item: absoluteUrl("/resources/") },
      { "@type": "ListItem", position: 3, name: data.title, item: absoluteUrl(path) },
    ],
  },
];
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} canonicalPath={path} jsonLd={jsonLd} ogImage={coverImage?.src}>
  <main id="main-content" class="site-wrap flex-1 py-xl lg:py-2xl">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Resources", href: "/resources/" }, { label: data.title }]} />
    <div class="grid gap-2xl mt-lg lg:grid-cols-12 lg:gap-x-xl">
      <div class="lg:col-span-7">
        <p class="type-label">
          <span class:list={["resource-badge", { "resource-badge--free": data.free }]}>{data.free ? "Free" : data.price ?? "Paid"}</span>
        </p>
        <h1 class="type-h1 mt-md">{data.title}</h1>
        <p class="type-body-lg mt-md max-w-prose">{data.summary}</p>
        {data.cover && (
          <div class="media-frame mt-xl">
            <Image src={data.cover} alt={data.coverAlt ?? ""} widths={[640, 960, 1200]} sizes="(min-width: 1024px) 55vw, 92vw" loading="eager" />
          </div>
        )}
        <div class="article-body mt-xl">
          <Content />
        </div>
        {data.includes.length > 0 && (
          <>
            <h2 class="type-h2 mt-2xl">What’s included</h2>
            <ul class="fit-list mt-md">
              {data.includes.map((line) => <li>{line}</li>)}
            </ul>
          </>
        )}
        {data.previews.length > 0 && (
          <>
            <h2 class="type-h2 mt-2xl">Sample pages</h2>
            <ul class="article-grid mt-md">
              {data.previews.map((preview) => (
                <li>
                  <div class="media-frame">
                    <Image src={preview.src} alt={preview.alt} widths={[400, 800]} sizes="(min-width: 1024px) 30vw, 92vw" />
                  </div>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
      <aside class="lg:col-span-5">
        {data.free ? (
          <FreeDownloadForm slug={resource.id} title={data.title} endpoint={data.downloadFormUrl} />
        ) : (
          <div class="lead-form resource-action">
            <p class="type-label">{data.price ?? "Price to be announced"}</p>
            {data.buyUrl ? (
              <p class="mt-lg">
                <a class="btn-primary" href={data.buyUrl} rel="noopener">Buy and Download</a>
              </p>
            ) : (
              <p class="type-body mt-md">This resource will be available to buy soon.</p>
            )}
          </div>
        )}
        {facts.length > 0 && (
          <dl class="resource-facts type-body-sm mt-xl">
            {facts.map((fact) => (
              <>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </>
            ))}
          </dl>
        )}
        {data.printingNotes && (
          <>
            <h2 class="type-h4 mt-xl">Printing</h2>
            <p class="type-body-sm mt-sm">{data.printingNotes}</p>
          </>
        )}
        {data.licence && (
          <>
            <h2 class="type-h4 mt-xl">Permitted use</h2>
            <p class="type-body-sm mt-sm">{data.licence}</p>
          </>
        )}
        {inCollections.length > 0 && (
          <>
            <h2 class="type-h4 mt-xl">Also in</h2>
            <ul class="type-body-sm mt-sm">
              {inCollections.map((c) => (
                <li><a href={sitePath(`/collections/${c.id}/`)}>{c.data.title}</a></li>
              ))}
            </ul>
          </>
        )}
        {data.subjects.length > 0 && (
          <p class="type-body-sm mt-xl">
            More in{" "}
            {data.subjects.map((name, i) => (
              <Fragment>{i > 0 ? ", " : ""}<a href={sitePath(`/resources/?subject=${topicByName(name)?.slug ?? ""}`)}>{topicLabel(name)}</a></Fragment>
            ))}.
          </p>
        )}
        <p class="type-body-sm mt-md">
          See <a href={sitePath("/download-policy/")}>downloads and refunds</a>.
        </p>
      </aside>
    </div>
  </main>
  <CtaBanner />
</BaseLayout>
