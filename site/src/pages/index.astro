---
import HeroFlow from "../components/HeroFlow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import FaqBlock from "../components/FaqBlock.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { SITE_NAME } from "../config/site";
import { TOPICS } from "../lib/topics";
import { sitePath } from "../lib/url";

const title = `Printable Homeschool Resources | ${SITE_NAME}`;
const description =
  "Beautifully crafted printable learning resources for curious children aged 3 to 10: free and paid PDFs and curated collections, made for families to use.";

// The five initial content pillars (intake), with a one-line description each.
const pillarLines: Record<string, string> = {
  "history and civilizations": "People, places and civilizations, brought to life for young children.",
  "science and the natural world": "How the world works, from the Earth itself to the life around us.",
  "mathematics and discovery": "Numbers, shapes and patterns, explored with hands and eyes.",
  "seasons, holidays and traditions": "Learning that follows the year and the moments families mark.",
  "geography, culture and the world": "Maps, places and peoples, approached with curiosity and care.",
};
const pillars = TOPICS.map((topic) => ({ name: topic.h1, slug: topic.slug, line: pillarLines[topic.name] }));

const differences = [
  {
    title: "Clean, elegant design",
    body: "Materials that are a pleasure to look at and to use, without visual clutter or noise.",
  },
  {
    title: "Thoughtful, accurate content",
    body: "Clear, carefully structured material that respects both the subject and the child.",
  },
  {
    title: "An independent approach",
    body: "Not a curriculum and not tied to one educational method. Each resource stands on its own.",
  },
  {
    title: "Beyond the page",
    body: "Practical materials that can lead to activities, observation, conversation and discovery, not just pages to fill in.",
  },
];

const isList = [
  "An independent resource brand and a growing library of printable materials",
  "Free resources, individual resources and curated collections",
  "Made for curious children aged roughly 3 to 10, and the parents who learn alongside them",
];
const isNotList = [
  "A prescribed curriculum or a fixed sequence to follow",
  "Committed to one educational philosophy or branded method",
  "A generic, noisy worksheet catalogue",
];

const faqs = [
  {
    question: "What ages are the resources for?",
    answer:
      "The resources are made mainly for children aged roughly 3 to 10. Age ranges are a guide: you know your child best.",
  },
  {
    question: "What format do I receive?",
    answer:
      "Resources are digital, downloadable PDF files, designed to be printed and used at home. Nothing is shipped.",
  },
  {
    question: "How do free downloads work?",
    answer:
      "Free resources are available at no charge in exchange for an email address. Asking for a free resource does not sign you up to the newsletter; joining it is a separate choice.",
  },
  {
    question: "Are free resources cut-down samples of paid ones?",
    answer:
      "No. Free resources are made to be excellent in their own right, with the same care as everything else in the library.",
  },
  {
    question: "Are the resources tied to a particular curriculum or teaching method?",
    answer:
      "No. The Home School Barn is independent. Resources stand alone and do not follow a prescribed sequence. Some may share ideas found in approaches such as Waldorf education, but the library is not tied to any one method.",
  },
  {
    question: "Are the resources only for homeschooling families?",
    answer:
      "They are made with homeschooling families in mind, and can also be used by parents looking for thoughtful ways to supplement their children's education.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-lg pt-xl lg:pb-xl lg:pt-2xl">
      <div class="grid gap-xl md:grid-cols-12 md:items-center md:gap-lg">
        <div class="hero-reveal md:col-span-6">
          <h1 class="hero-headline">
            <span class="type-label mb-md block">Printable learning resources</span>
            Beautifully crafted learning experiences for curious children.
          </h1>
          <p class="type-body mt-lg max-w-prose">
            Thoughtful, high-quality and practical learning materials for children
            aged roughly 3 to 10, without the visual clutter, generic feel or
            busywork of mass-produced worksheets.
          </p>
          <p class="mt-xl flex flex-wrap items-center gap-md">
            <a class="btn-primary" href={sitePath("/resources/")}>Browse the Library</a>
            <a class="btn-quiet" href={sitePath("/resources/?type=free")}>Get a Free Resource</a>
          </p>
        </div>
        <div class="hero-reveal md:col-span-6">
          <HeroFlow />
        </div>
      </div>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="subjects-heading">
      <p class="type-label">In the library</p>
      <h2 id="subjects-heading" class="type-h2 mt-md">Subjects, seasons and the wider world.</h2>
      <ul class="glance-grid glance-grid--3 mt-2xl">
        {pillars.map((pillar) => (
          <li class="experience-card experience-card--compact">
            <p class="experience-card__value">{pillar.name}</p>
            <p class="type-h4">{pillar.line}</p>
          </li>
        ))}
      </ul>
      <p class="mt-xl">
        <a class="btn-quiet" href={sitePath("/resources/")}>Explore the resources</a>
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="different-heading">
      <p class="type-label">Why it is different</p>
      <h2 id="different-heading" class="type-h2 mt-md">Made with care, and made to be used.</h2>
      <ul class="principle-list mt-2xl">
        {differences.map((item) => (
          <li>
            <h3 class="type-h3">{item.title}</h3>
            <p class="type-body mt-sm">{item.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="what-heading">
      <p class="type-label">What it is</p>
      <h2 id="what-heading" class="type-h2 mt-md">A library to explore, not a curriculum to follow.</h2>
      <div class="fit-grid mt-2xl">
        <div class="plan-card">
          <p class="plan-card__label">The Home School Barn is</p>
          <ul class="fit-list">
            {isList.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div class="plan-card plan-card--plain">
          <p class="plan-card__label" style="color: #5C5C5C">It is not</p>
          <ul class="fit-list fit-list--no">
            {isNotList.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="free-heading">
      <p class="type-label">Free resources</p>
      <h2 id="free-heading" class="type-h2 mt-md">Free should not mean lower quality.</h2>
      <p class="type-body mt-md max-w-prose">
        Free resources are not watered-down samples of paid products. They are
        complete resources, made with the same care, and yours in exchange for
        an email address.
      </p>
      <p class="mt-xl">
        <a class="btn-primary" href={sitePath("/resources/?type=free")}>Get a Free Resource</a>
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="faq-heading">
      <FaqBlock faqs={faqs} bordered={false} />
    </section>

    <section class="site-wrap section-block reveal">
      <NewsletterSignup />
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
