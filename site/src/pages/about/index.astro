---
/**
 * About: brand-focused (intake: the creator is not the public face and no
 * personal profile is built). The #editorial anchor is the article byline target.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { orgId } from "seo-core";
import { SITE_NAME, SITE_URL } from "../../config/site";
import { absoluteUrl, sitePath } from "../../lib/url";

const title = `About ${SITE_NAME}: Our Approach to Learning`;
const description =
  "The Home School Barn is an independent resource brand making beautifully crafted, practical printable learning materials for curious children aged 3 to 10.";

const principles = [
  {
    title: "Accurate and clear",
    body: "Content is written with care for accuracy and clarity, and structured so that a child can follow it and a parent can trust it.",
  },
  {
    title: "Clean and beautiful",
    body: "Pages are designed to be calm and elegant: never flashy, noisy or overly childish.",
  },
  {
    title: "Practical and ready to use",
    body: "Print it and begin. Where it helps, a resource includes a short parent guide explaining how to use it.",
  },
  {
    title: "More than pages to fill in",
    body: "Resources can invite activities, observation, conversation and discovery. Not every one needs an elaborate activity; the aim is thoughtful learning, not forced entertainment.",
  },
  {
    title: "Free means good",
    body: "Free resources are excellent in their own right, never a watered-down sample of something paid.",
  },
  {
    title: "Stand-alone by design",
    body: "Every resource can be used on its own. There is no prescribed sequence and no curriculum to keep up with.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  {
    "@type": "AboutPage",
    name: title,
    description,
    url: absoluteUrl("/about/"),
    mainEntity: { "@id": orgId(SITE_URL) },
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/about/" jsonLd={jsonLd}>
  <main id="main-content" class="flex-1">
    <section class="site-wrap section-block pt-2xl lg:pt-3xl" aria-labelledby="about-heading">
      <p class="type-label">About</p>
      <h1 id="about-heading" class="type-h1 mt-md max-w-prose">
        A home for beautifully crafted learning experiences for curious children.
      </h1>
      <p class="type-body-lg mt-lg max-w-prose">
        {SITE_NAME} is an independent resource brand and a growing library of
        educational materials. It makes thoughtfully crafted, beautifully
        designed printable resources and practical learning experiences, across
        a range of subjects, seasons and themes.
      </p>

      <h2 class="type-h3 mt-2xl">Who it is for</h2>
      <p class="type-body mt-sm max-w-prose">
        Homeschooling parents and families with children aged roughly 3 to 10
        come first. The resources are also for parents looking for thoughtful
        ways to supplement their children’s education, and may be useful to
        tutors, educators and homeschool co-ops.
      </p>

      <h2 class="type-h3 mt-xl">An independent approach</h2>
      <p class="type-body mt-sm max-w-prose">
        {SITE_NAME} is not a prescribed curriculum and does not follow a single
        educational method. Some of its work may share ideas with approaches
        such as Waldorf education, but the library is not tied to any one
        philosophy. Each resource stands on its own, and families are free to
        use them in whatever order suits them.
      </p>
      <p class="type-body mt-md max-w-prose">
        The library grows around what is genuinely worth exploring, rather than
        a fixed syllabus or publishing schedule.
      </p>

      <h2 class="type-h3 mt-xl">What it does not promise</h2>
      <p class="type-body mt-sm max-w-prose">
        Every child is different. The resources are made with care, but they do
        not promise a set sequence or particular educational outcomes. You know
        your child best.
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="principles-heading">
      <p class="type-label">How resources are made</p>
      <h2 id="principles-heading" class="type-h2 mt-md">Beautiful, practical and ready to use.</h2>
      <ul class="principle-list mt-2xl">
        {principles.map((item) => (
          <li>
            <h3 class="type-h3">{item.title}</h3>
            <p class="type-body mt-sm">{item.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="editorial" class="site-wrap section-block rule reveal" aria-labelledby="editorial-heading">
      <p class="type-label">Articles</p>
      <h2 id="editorial-heading" class="type-h2 mt-md">About our articles</h2>
      <p class="type-body mt-md max-w-prose">
        Articles on {SITE_NAME} are published under the brand name. They aim to
        answer the questions parents actually ask, such as how to explain a
        topic or how to mark a season or holiday with children, genuinely and
        thoroughly, and to point to a relevant resource only where one helps.
      </p>
      <p class="mt-xl flex flex-wrap items-center gap-md">
        <a class="btn-primary" href={sitePath("/resources/")}>Browse the Library</a>
        <a class="btn-quiet" href={sitePath("/articles/")}>Read the articles</a>
      </p>
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
