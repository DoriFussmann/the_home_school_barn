---
// Static alternative to HeroFlow: the five steps in the intake, as one card.
// No product names, prices, counts or claims.
const steps = [
  { title: "Explore the library", text: "Printable resources across history, science, math, the seasons and the wider world." },
  { title: "Find the right resource", text: "Browse by age, subject, season or theme." },
  { title: "Download free, or buy", text: "Free resources need only an email address; resources and collections can be bought." },
  { title: "Receive the PDF", text: "By email, or through the download after checkout." },
  { title: "Print, explore and enjoy together", text: "Activities, observation and conversation beyond the page." },
];
---

<div class="hero-steps" role="img" aria-label="How The Home School Barn works, in five steps: explore the library, find the right resource, download free or buy, receive the PDF, then print, explore and enjoy it together.">
  <p class="hero-steps__label" aria-hidden="true">How the library works</p>
  <ol class="hero-steps__list" aria-hidden="true">
    {
      steps.map((step, i) => (
        <li class="hero-steps__item">
          <span class="hero-steps__num">{String(i + 1).padStart(2, "0")}</span>
          <span class="hero-steps__body">
            <span class="hero-steps__title">{step.title}</span>
            <span class="hero-steps__text">{step.text}</span>
          </span>
        </li>
      ))
    }
  </ol>
  <p class="hero-steps__foot" aria-hidden="true">Free and paid resources · No curriculum to follow</p>
</div>

<style>
  .hero-steps {
    background: #ffffff;
    border: 1px solid #e4e2de;
    border-radius: 16px;
    padding: 28px 28px 22px;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.06);
  }
  .hero-steps__label {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7a5c28;
  }
  .hero-steps__list {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    position: relative;
  }
  .hero-steps__list::before {
    content: "";
    position: absolute;
    left: 15px;
    top: 18px;
    bottom: 18px;
    width: 1px;
    background: #e4e2de;
  }
  .hero-steps__item {
    position: relative;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 16px;
    padding: 12px 0;
  }
  .hero-steps__num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #b5935a;
    font-family: "IBM Plex Mono", "Courier New", monospace;
    font-size: 11px;
    color: #7a5c28;
  }
  .hero-steps__body {
    display: grid;
    gap: 2px;
  }
  .hero-steps__title {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    color: #1a1a2e;
  }
  .hero-steps__text {
    font-size: 14px;
    line-height: 1.55;
    color: #5c5c5c;
  }
  .hero-steps__foot {
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px solid #e4e2de;
    font-size: 12px;
    color: #5c5c5c;
  }
</style>
