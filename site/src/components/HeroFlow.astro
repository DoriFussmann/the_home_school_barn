---
// Home hero: how the library works, as one animated card that steps through
// the five steps in the intake (WORKING DIRECTION):
// Explore → Find → Choose → Receive → Enjoy together.
// No product names, prices, counts or claims. Autoplay pauses on hover, focus
// or a hidden tab; the rail jumps to any step; reduced motion shows each step still.
const STEPS = [
  { name: "Explore", stage: "Discover", title: "Explore the library", text: "Printable resources across history, science, math, the seasons and the wider world.", visual: `<svg viewBox="0 0 520 180" class="hfl-svg" aria-hidden="true">
  ${["History", "Science", "Math", "Seasons", "Geography", "Nature", "Holidays", "Cultures"]
    .map((label, i) => {
      const x = 12 + (i % 4) * 126;
      const y = i < 4 ? 4 : 94;
      const free = i === 1 || i === 6;
      return `<g class="fi" style="--d:${i * 90}ms"><rect class="card" x="${x}" y="${y}" width="114" height="80" rx="10"/><rect class="band" x="${x}" y="${y}" width="114" height="32" rx="10"/><rect class="band" x="${x}" y="${y + 16}" width="114" height="16"/><text class="t t--sm t--b" x="${x + 12}" y="${y + 54}">${label}</text><rect class="lane" x="${x + 12}" y="${y + 63}" width="64" height="6" rx="3"/>${free ? `<g class="pop" style="--d:${900 + i * 60}ms"><rect class="node node--brass" x="${x + 66}" y="${y + 8}" width="40" height="17" rx="8.5"/><text class="t t--xs t--brass t--b" x="${x + 86}" y="${y + 20}" text-anchor="middle">Free</text></g>` : ""}</g>`;
    })
    .join("")}
</svg>` },
  { name: "Find", stage: "Discover", title: "Find the right resource", text: "Browse by age, subject, season or theme.", visual: `<svg viewBox="0 0 520 180" class="hfl-svg" aria-hidden="true">
  ${[
    { label: "Age", chips: ["3–5", "5–7", "7–10"], on: 1 },
    { label: "Subject", chips: ["History", "Science", "Math"], on: 1 },
    { label: "Season", chips: ["Autumn", "Winter", "Spring"], on: 0 },
  ]
    .map((row, r) => {
      const y = 12 + r * 56;
      return `<g class="fi" style="--d:${r * 160}ms"><text class="t t--sm t--muted lane-label" x="12" y="${y + 21}">${row.label}</text>${row.chips
        .map((chip, c) => {
          const x = 120 + c * 132;
          const hit = c === row.on ? " hit" : "";
          return `<g class="chip${hit}" style="--d:${700 + r * 250}ms"><rect class="tile" x="${x}" y="${y}" width="120" height="30" rx="15"/><text class="t t--sm" x="${x + 60}" y="${y + 19.5}" text-anchor="middle">${chip}</text></g>`;
        })
        .join("")}</g>`;
    })
    .join("")}
</svg>` },
  { name: "Choose", stage: "Get", title: "Download free, or buy", text: "Free resources need only an email address. Resources and collections can be bought and downloaded.", visual: `<svg viewBox="0 0 520 180" class="hfl-svg" aria-hidden="true">
  <g class="fi"><rect class="card" x="10" y="4" width="240" height="168" rx="12"/>
    <text class="t t--sm t--muted lane-label" x="30" y="32">Free resource</text>
    <text class="t t--b" x="30" y="70" style="font-size:22px">Free</text>
    <text class="t t--sm t--muted" x="30" y="96">Email address required</text>
    <g class="pop" style="--d:600ms"><rect class="node node--brass" x="30" y="122" width="140" height="32" rx="16"/><text class="t t--sm t--brass t--b" x="100" y="142" text-anchor="middle">Download free</text></g></g>
  <g class="fi" style="--d:250ms"><rect class="card" x="270" y="4" width="240" height="168" rx="12"/>
    <text class="t t--sm t--muted lane-label" x="290" y="32">Resource or collection</text>
    <text class="t t--b" x="290" y="70" style="font-size:22px">Paid</text>
    <text class="t t--sm t--muted" x="290" y="96">Price shown on each page</text>
    <g class="pop" style="--d:850ms"><rect class="node node--ink" x="290" y="122" width="160" height="32" rx="16"/><text class="t t--sm t--b t--inv" x="370" y="142" text-anchor="middle">Buy and download</text></g></g>
</svg>` },
  { name: "Receive", stage: "Get", title: "Receive the PDF", text: "By email, or through the download after checkout.", visual: `<svg viewBox="0 0 520 180" class="hfl-svg" aria-hidden="true">
  <path class="flow" d="M180 90 L330 90"/>
  <g class="fi"><rect class="node" x="40" y="44" width="140" height="92" rx="10"/><path class="line" d="M40 50 L110 100 L180 50"/><text class="t t--sm t--muted" x="110" y="164" text-anchor="middle">Email</text></g>
  <g class="fi" style="--d:200ms"><text class="t t--sm t--muted" x="255" y="78" text-anchor="middle">or</text></g>
  <g class="fi" style="--d:450ms"><path class="doc" d="M350 26 L430 26 L460 56 L460 154 L350 154 Z"/><path class="line" d="M430 26 L430 56 L460 56"/>
    <rect class="node node--brass" x="368" y="94" width="56" height="26" rx="6"/><text class="t t--sm t--brass t--b" x="396" y="112" text-anchor="middle">PDF</text>
    <text class="t t--sm t--muted" x="405" y="176" text-anchor="middle">Download</text></g>
</svg>` },
  { name: "Enjoy", stage: "Use", title: "Print, explore and enjoy together", text: "Activities, observation and conversation that carry on beyond the page.", visual: `<svg viewBox="0 0 520 180" class="hfl-svg" aria-hidden="true">
  <path class="draw" pathLength="1" d="M150 76 L200 76" style="--d:500ms"/>
  <path class="draw" pathLength="1" d="M320 76 L370 76" style="--d:900ms"/>
  <g class="fi"><rect class="node node--brass" x="30" y="16" width="120" height="120" rx="14"/>
    <path class="doc" d="M70 40 L104 40 L116 52 L116 112 L70 112 Z"/><rect class="lane" x="78" y="62" width="28" height="5" rx="2.5"/><rect class="lane" x="78" y="74" width="22" height="5" rx="2.5"/><rect class="lane" x="78" y="86" width="28" height="5" rx="2.5"/>
    <text class="t t--brass t--b" x="90" y="164" text-anchor="middle">Print</text></g>
  <g class="fi" style="--d:350ms"><rect class="node node--brass" x="200" y="16" width="120" height="120" rx="14"/>
    <circle class="line" cx="252" cy="70" r="20"/><path class="line" d="M266 84 L284 102"/>
    <text class="t t--brass t--b" x="260" y="164" text-anchor="middle">Explore</text></g>
  <g class="fi" style="--d:750ms"><rect class="node node--brass" x="370" y="16" width="120" height="120" rx="14"/>
    <circle class="person" cx="412" cy="62" r="11"/><path class="person" d="M394 100 q18 -22 36 0"/>
    <circle class="person" cx="452" cy="70" r="8"/><path class="person" d="M439 100 q13 -16 26 0"/>
    <text class="t t--brass t--b" x="430" y="164" text-anchor="middle">Discover together</text></g>
</svg>` },
];
---

<div class="hfl" data-hfl role="region" aria-roledescription="carousel" aria-label="How The Home School Barn works, in five steps">
  <div class="hfl__frame">
    {
      STEPS.map((s, i) => (
        <div class="hfl__slide" data-slide={i} aria-hidden={i === 0 ? "false" : "true"}>
          <p class="hfl__label">Step {i + 1} of {STEPS.length} · {s.stage}</p>
          <h3 class="hfl__title">{s.title}</h3>
          <p class="hfl__text">{s.text}</p>
          <Fragment set:html={s.visual} />
        </div>
      ))
    }
  </div>
  <div class="hfl__rail">
    {
      STEPS.map((s, i) => (
        <button type="button" class="hfl__step" data-step={i} aria-label={`Step ${i + 1}: ${s.title}`}>
          <span class="hfl__bar"><i /></span>
          <span class="hfl__name">{s.name}</span>
        </button>
      ))
    }
  </div>
  <div class="hfl__foot">
    <button class="hfl__btn" data-toggle type="button">Pause</button>
  </div>
</div>

<style is:global>
  .hfl {
    --ink: #1a1a2e; --surface: #ffffff; --border: #e4e2de; --muted: #5c5c5c;
    --brass: #b5935a; --brass-text: #7a5c28; --brass-tint: #f3ece0; --tint: #f3f1ec;
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    width: 100%;
  }
  .hfl__frame {
    position: relative; display: grid;
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    box-shadow: 0 1px 2px rgba(26, 26, 46, 0.04), 0 12px 32px -18px rgba(26, 26, 46, 0.18);
    overflow: hidden;
  }
  /* All slides share one grid cell, so the frame keeps the tallest height. */
  .hfl__slide {
    grid-area: 1 / 1; padding: 28px;
    opacity: 0; transform: translateY(8px); visibility: hidden;
    transition: opacity 500ms var(--ease), transform 500ms var(--ease), visibility 0s 500ms;
  }
  .hfl__slide.is-active { opacity: 1; transform: none; visibility: visible; transition: opacity 500ms var(--ease), transform 500ms var(--ease); }
  .hfl__label { margin: 0; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brass-text); }
  .hfl__title { margin: 12px 0 0; font-size: 24px; line-height: 1.2; font-weight: 500; color: var(--ink); }
  .hfl__text { margin: 10px 0 0; font-size: 15px; line-height: 1.55; color: var(--muted); max-width: 42ch; }

  /* Step illustrations (inline SVG). Items fade/draw in once the slide is active. */
  .hfl-svg { display: block; width: 100%; height: auto; margin-top: 24px; overflow: visible; }
  .hfl-svg .t { font-family: inherit; font-size: 13px; fill: var(--ink); }
  .hfl-svg .t--sm { font-size: 11.5px; }
  .hfl-svg .t--xs { font-size: 10px; }
  .hfl-svg .t--b { font-weight: 500; }
  .hfl-svg .t--brass { fill: var(--brass-text); }
  .hfl-svg .t--muted { fill: var(--muted); }
  .hfl-svg .t--inv { fill: var(--surface); }
  .hfl-svg .lane-label { letter-spacing: 0.06em; text-transform: uppercase; font-size: 10px; }
  .hfl-svg .node { fill: var(--tint); stroke: var(--border); }
  .hfl-svg .node--brass { fill: var(--brass-tint); stroke: var(--brass); }
  .hfl-svg .node--ink { fill: var(--ink); stroke: var(--ink); }
  .hfl-svg .card { fill: #fdfcfa; stroke: var(--border); }
  .hfl-svg .band { fill: var(--tint); }
  .hfl-svg .lane { fill: #e9e6e0; }
  .hfl-svg .doc { fill: var(--surface); stroke: var(--ink); stroke-width: 1.4; stroke-linejoin: round; }
  .hfl-svg .line { fill: none; stroke: var(--ink); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .hfl-svg .person { fill: none; stroke: var(--brass-text); stroke-width: 1.6; stroke-linecap: round; }

  .hfl-svg .fi { opacity: 0; transition: opacity 500ms var(--ease) var(--d, 0ms); }
  .hfl__slide.is-active .fi { opacity: 1; }
  .hfl-svg .pop { opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(0.6); transition: opacity 300ms var(--ease) var(--d, 0ms), transform 400ms var(--ease) var(--d, 0ms); }
  .hfl__slide.is-active .pop { opacity: 1; transform: none; }
  .hfl-svg .draw { fill: none; stroke: var(--brass); stroke-width: 1.6; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 700ms var(--ease) var(--d, 0ms); }
  .hfl__slide.is-active .draw { stroke-dashoffset: 0; }

  /* Find: the chosen filter in each row lights up. */
  .hfl-svg .tile { fill: var(--surface); stroke: var(--border); transition: fill 400ms var(--ease) var(--d, 0ms), stroke 400ms var(--ease) var(--d, 0ms); }
  .hfl__slide.is-active .hit .tile { fill: var(--brass-tint); stroke: var(--brass); }

  /* Receive: the file travels along the connector. */
  .hfl-svg .flow { fill: none; stroke: var(--brass); stroke-width: 1.6; stroke-dasharray: 4 6; animation: hfl-flow 900ms linear infinite; animation-play-state: paused; }
  .hfl__slide.is-active .flow { animation-play-state: running; }
  @keyframes hfl-flow { to { stroke-dashoffset: -20; } }

  /* Rail */
  .hfl__rail { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 16px; }
  .hfl__step { appearance: none; border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font: inherit; color: var(--muted); }
  .hfl__bar { display: block; height: 2px; background: var(--border); border-radius: 1px; overflow: hidden; }
  .hfl__bar i { display: block; height: 100%; width: 0; background: var(--brass); }
  .hfl__step.is-done .hfl__bar i { width: 100%; }
  .hfl__step.is-active .hfl__bar i { animation: hfl-fill linear forwards; animation-duration: var(--dur, 3000ms); }
  .hfl.is-paused .hfl__step.is-active .hfl__bar i { animation-play-state: paused; }
  .hfl__name { display: block; font-size: 12px; margin-top: 8px; white-space: nowrap; }
  .hfl__step.is-active .hfl__name { color: var(--ink); }
  .hfl__step:focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; border-radius: 2px; }
  @keyframes hfl-fill { from { width: 0; } to { width: 100%; } }
  .hfl__foot { display: flex; justify-content: flex-end; margin-top: 12px; }
  .hfl__btn { appearance: none; border: 1px solid var(--border); background: var(--surface); border-radius: 15px; padding: 4px 12px; font: inherit; font-size: 12px; color: var(--ink); cursor: pointer; }

  @media (max-width: 480px) {
    .hfl__slide { padding: 24px 22px 28px; }
    .hfl__title { font-size: 22px; }
    .hfl__name { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hfl__slide, .hfl-svg * { transition: none !important; animation: none !important; }
    .hfl__step.is-active .hfl__bar i { animation: none; width: 100%; }
  }
</style>

<script>
  const DURATION = 3000;
  document.querySelectorAll<HTMLElement>("[data-hfl]").forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0, timer = 0, paused = false, userPaused = false, startedAt = 0, remaining = DURATION;

    const schedule = (ms: number) => {
      clearTimeout(timer);
      remaining = ms; startedAt = performance.now();
      if (!paused && !reduce) timer = window.setTimeout(() => go(index + 1), ms);
    };
    const go = (i: number) => {
      index = (i + slides.length) % slides.length; // after the last step, repeat
      slides.forEach((s, j) => { s.classList.toggle("is-active", j === index); s.setAttribute("aria-hidden", String(j !== index)); });
      steps.forEach((b, j) => {
        b.classList.toggle("is-done", j < index);
        b.classList.remove("is-active");
        b.setAttribute("aria-current", j === index ? "step" : "false");
      });
      void steps[index].offsetWidth; // restart the bar animation
      steps[index].classList.add("is-active");
      steps[index].style.setProperty("--dur", DURATION + "ms");
      schedule(DURATION);
    };
    const pause = () => {
      if (paused) return;
      paused = true; root.classList.add("is-paused");
      clearTimeout(timer); remaining -= performance.now() - startedAt;
    };
    const resume = () => {
      if (!paused || userPaused) return;
      paused = false; root.classList.remove("is-paused");
      schedule(Math.max(400, remaining));
    };

    steps.forEach((b, j) => b.addEventListener("click", () => go(j)));
    root.addEventListener("mouseenter", pause);
    root.addEventListener("mouseleave", resume);
    root.addEventListener("focusin", pause);
    root.addEventListener("focusout", resume);
    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      toggle.textContent = userPaused ? "Play" : "Pause";
      if (userPaused) pause(); else { paused = true; resume(); }
    });
    document.addEventListener("visibilitychange", () => (document.hidden ? pause() : resume()));
    if (reduce) toggle.hidden = true;
    go(0);
  });
</script>
