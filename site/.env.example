# Public site only. Never commit real secrets.
# Copy to .env if you need local overrides.

# Newsletter signup form POST endpoint (email platform not chosen yet).
# Receives `email`. Leave empty to show "signups open soon" instead of a form.
PUBLIC_NEWSLETTER_ENDPOINT=

# Free-resource download form POST endpoint (delivery platform not chosen yet).
# Receives `email`, `resource` and `newsletter_consent`. A resource's own
# downloadFormUrl overrides it. Leave empty to show "available soon".
PUBLIC_FREE_DOWNLOAD_ENDPOINT=

# Google Analytics measurement ID (G-XXXXXXXX). Leave empty to keep analytics absent.
PUBLIC_ANALYTICS_ID=

# Google Search Console verification token. Leave empty if unused.
PUBLIC_SEARCH_CONSOLE_VERIFICATION=
